# Admin portal passcode (hashed).
#
# Do not put a passcode here. Set one with:
#
#   npm run set-passcode
#
# That writes the SHA-256 hash of your passcode into .env.local, which is
# gitignored. The hash is baked into the browser bundle at build time, so the
# admin gate is obfuscation rather than real security — see the note at the top
# of src/utils/adminAuth.ts for what it does and does not protect.
#
# Until this is set, the admin portal shows a setup notice and refuses all logins.
VITE_ADMIN_PASSCODE_HASH=
